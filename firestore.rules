rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return userDocExists() && getUserData().role == role;
    }

    function isMasterAdmin() {
      return hasRole('master_admin');
    }

    function isAdmin() {
      return hasRole('admin') || isMasterAdmin();
    }

    function isDriver() {
      return hasRole('driver') || isAdmin();
    }

    function isHR() {
      return hasRole('hr') || isAdmin();
    }

    // ── Users collection ─────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isAdmin() || isHR());
    }

    // ── Settings collection ──────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Shuttle Rides ─────────────────────────────────────────────────
    match /shuttleRides/{rideId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ── General Requests ─────────────────────────────────────────────
    match /requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ── Vehicles collection ───────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
